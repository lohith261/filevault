generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id             String     @id @default(cuid())
  slug           String     @unique @db.VarChar(6)
  label          String     @default("")
  userId         String?
  passwordHash   String?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  totalSizeBytes BigInt     @default(0)
  entryFile      String     @default("index.html")
  storagePrefix  String
  files          SiteFile[]
  views          SiteView[]

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("sites")
}

model SiteFile {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  path       String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime @default(now())

  @@index([siteId])
  @@unique([siteId, path])
  @@map("site_files")
}

model SiteView {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  viewedAt  DateTime @default(now())

  @@index([siteId])
  @@index([siteId, viewedAt])
  @@map("site_views")
}
