generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Site {
  id             String     @id @default(cuid())
  slug           String     @unique
  label          String     @default("")
  userId         String?
  passwordHash   String?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  totalSizeBytes BigInt     @default(0)
  entryFile      String     @default("index.html")
  storagePrefix  String
  customDomain   String?    @unique
  files          SiteFile[]
  views          SiteView[]

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("sites")
}

model SiteFile {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  path       String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime @default(now())

  @@index([siteId])
  @@unique([siteId, path])
  @@map("site_files")
}

model SiteView {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  viewedAt  DateTime @default(now())

  @@index([siteId])
  @@index([siteId, viewedAt])
  @@map("site_views")
}

model AnonUploadLog {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("anon_upload_logs")
}

// ── AI Agent system ──────────────────────────────────────────────────────────

model Agent {
  id              String        @id @default(cuid())
  name            String?
  apiKeyHash      String        @unique
  webhookUrl      String?
  createdAt       DateTime      @default(now())
  files           AgentFile[]
  embeddings      Embedding[]
  memories        Memory[]
  collections     Collection[]
  sharesGiven     AgentShare[]  @relation("SharesGiven")
  sharesReceived  AgentShare[]  @relation("SharesReceived")

  @@map("agents")
}

model AgentFile {
  id              String           @id @default(cuid())
  agentId         String
  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name            String
  mimeType        String
  sizeBytes       BigInt           @default(0)
  storageKey      String
  metadata        String?
  isIndexed       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  embeddings      Embedding[]
  collectionFiles CollectionFile[]

  @@index([agentId])
  @@map("agent_files")
}

model Collection {
  id        String           @id @default(cuid())
  agentId   String
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  files     CollectionFile[]

  @@index([agentId])
  @@map("collections")
}

model CollectionFile {
  collectionId String
  fileId       String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  file         AgentFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([collectionId, fileId])
  @@map("collection_files")
}

model AgentShare {
  id             String   @id @default(cuid())
  ownerAgentId   String
  granteeAgentId String
  createdAt      DateTime @default(now())
  ownerAgent     Agent    @relation("SharesGiven", fields: [ownerAgentId], references: [id], onDelete: Cascade)
  granteeAgent   Agent    @relation("SharesReceived", fields: [granteeAgentId], references: [id], onDelete: Cascade)

  @@unique([ownerAgentId, granteeAgentId])
  @@index([granteeAgentId])
  @@map("agent_shares")
}

model Embedding {
  id        String     @id @default(cuid())
  agentId   String
  agent     Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileId    String?
  file      AgentFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  content   String
  vector    String
  createdAt DateTime   @default(now())

  @@index([agentId])
  @@index([fileId])
  @@map("embeddings")
}

model Memory {
  id        String    @id @default(cuid())
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  content   String
  vector    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId])
  @@map("memories")
}
