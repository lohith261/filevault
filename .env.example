# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension (required for semantic search).
# Local dev: docker compose up -d
#   DATABASE_URL="postgresql://filevault:filevault@localhost:5432/filevault"
# Production: Supabase connection pooler (port 6543, pgbouncer)
DATABASE_URL="postgresql://filevault:filevault@localhost:5432/filevault"

# Direct connection (port 5432) — used by prisma migrate deploy only.
# Bypasses pgbouncer so DDL migrations work. Same as DATABASE_URL for local dev.
DIRECT_URL="postgresql://filevault:filevault@localhost:5432/filevault"

# ─── Storage ─────────────────────────────────────────────────────────────────
# "r2" in production (Vercel is serverless — no persistent disk).
# "local" for local dev — files stored in UPLOADS_PATH.
STORAGE_DRIVER="local"
UPLOADS_PATH="./uploads"

# Cloudflare R2 — required when STORAGE_DRIVER=r2
# Get credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="filevault"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ─── AI / Embeddings ─────────────────────────────────────────────────────────
# Required for semantic search and file indexing.
# Model: openai/text-embedding-3-small via OpenRouter
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ─── App ─────────────────────────────────────────────────────────────────────
# Your public base URL — used to construct shareable links. No trailing slash.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Root domain for subdomain routing (e.g. myproject.filevault.host)
NEXT_PUBLIC_BASE_DOMAIN="filevault.host"

# Random 32+ character secret for the cleanup cron job endpoint.
CRON_SECRET="generate-a-random-32-char-string-here"

# ─── Clerk Auth (optional) ───────────────────────────────────────────────────
# App works fully without these (anonymous mode, no dashboard).
# Get keys at https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Upstash Redis for high-performance rate limiting.
# Falls back to DB-based rate limiting if omitted.
# Get a free database at https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Anonymous upload limits ─────────────────────────────────────────────────
ANON_MAX_SIZE_MB="10"
ANON_MAX_EXPIRY_HOURS="24"
